// Reusable appearance customization item.
//
// Right-click IWTFDYE.ITM and use ITEMDIAL.2DA's Customize button to open
// IWTFDYE.DLG. The dialog uses IWDEE's native ChangeColor() script action,
// so no consumable dyes or per-color helper spells are needed.

COPY_EXISTING ~POTN01.ITM~ ~override/IWTFDYE.ITM~
  SAY NAME1 ~Chromatic Dye Kit~
  SAY NAME2 ~Chromatic Dye Kit~
  SAY UNIDENTIFIED_DESC ~A reusable set of pigments and applicators for altering a character's appearance. Right-click the kit and choose Customize to recolor metal and decorative details, skin, leather and straps, armor and robe trim, or hair. The kit is never consumed.~
  SAY IDENTIFIED_DESC ~A reusable set of pigments and applicators for altering a character's appearance. Right-click the kit and choose Customize to recolor metal and decorative details, skin, leather and straps, armor and robe trim, or hair. The kit is never consumed.~

  // Turn the potion donor into a passive miscellaneous item. ITEMDIAL handles
  // all interaction, so the item needs no consumable ability or global effect.
  WRITE_SHORT 0x1c 0
  WRITE_SHORT 0x68 0
  WRITE_SHORT 0x70 0
BUT_ONLY

OUTER_SET iwtf_dye_customize = RESOLVE_STR_REF(~Customize~)
APPEND ~ITEMDIAL.2DA~ ~IWTFDYE %iwtf_dye_customize% IWTFDYE~ UNLESS ~^IWTFDYE[ %TAB%]~

COMPILE ~IWDEE-Tweaks-and-Fixes/dialogs/iwtfdye.d~

EXTEND_BOTTOM ~BALDUR.BCS~ ~IWDEE-Tweaks-and-Fixes/scripts/iwtfdye.baf~
