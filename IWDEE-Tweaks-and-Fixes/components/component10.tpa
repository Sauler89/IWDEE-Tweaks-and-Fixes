// Reusable appearance customization item.
//
// Right-click IWTFDYE.ITM in the inventory and use ITEMDIAL.2DA's Customize
// button to open IWTFDYE.DLG. Colors are changed directly on the character
// with ChangeColor(), rather than by persistent opcode 7 effects. No dye is
// consumed.

// Ensure the EE ChangeColor action is available to the dialogue compiler.
APPEND ~ACTION.IDS~
  ~440 ChangeColor(I:Range*Clownrge,I:Color*Clownclr)~
  UNLESS ~ChangeColor~

// Install the confirmed Chromatic Dye Kit artwork under a unique resref so the
// original CDUNI200 resource (and any other item using it) is never replaced.
COPY ~IWDEE-Tweaks-and-Fixes/bam/cduni200.bam~ ~override/IWTFDYE.BAM~

COPY_EXISTING ~SW1H01.ITM~ ~override/IWTFDYE.ITM~
  SAY NAME1 ~Chromatic Dye Kit~
  SAY NAME2 ~Chromatic Dye Kit~
  SAY UNIDENTIFIED_DESC ~A reusable set of pigments and applicators for altering a character's appearance. Right-click the kit in the inventory and choose Customize to recolor metal and decorative details, skin, leather and straps, armor and robe trim, or hair. The kit is never consumed.~
  SAY IDENTIFIED_DESC ~A reusable set of pigments and applicators for altering a character's appearance. Right-click the kit in the inventory and choose Customize to recolor metal and decorative details, skin, leather and straps, armor and robe trim, or hair. The kit is never consumed.~

  // Convert the sword donor into a passive miscellaneous dialog item.
  // ITEMDIAL requires the Conversable item flag (bit 11 / 0x0800). The
  // Movable and Displayable flags are kept as well. Do not inherit any weapon
  // usability restrictions or minimum-stat requirements from SW1H01.ITM.
  WRITE_LONG  0x18 0x0000080c
  WRITE_SHORT 0x1c 0
  WRITE_LONG  0x1e 0
  WRITE_SHORT 0x24 0
  WRITE_SHORT 0x26 0
  WRITE_BYTE  0x28 0
  WRITE_BYTE  0x29 0
  WRITE_BYTE  0x2a 0
  WRITE_BYTE  0x2b 0
  WRITE_BYTE  0x2c 0
  WRITE_BYTE  0x2d 0
  WRITE_BYTE  0x2e 0
  WRITE_BYTE  0x2f 0
  WRITE_BYTE  0x30 0
  WRITE_BYTE  0x31 0
  WRITE_SHORT 0x32 0
  WRITE_LONG  0x34 1
  WRITE_SHORT 0x38 1

  // Confirmed custom inventory icon; use the native potion ground icon.
  WRITE_ASCII 0x3a ~IWTFDYE~ #8
  WRITE_ASCII 0x44 ~gpotn01~ #8

  WRITE_SHORT 0x68 0
  WRITE_SHORT 0x70 0
BUT_ONLY

OUTER_SET iwtf_dye_customize = RESOLVE_STR_REF(~Customize~)
APPEND ~ITEMDIAL.2DA~ ~IWTFDYE %iwtf_dye_customize% IWTFDYE~ UNLESS ~^IWTFDYE[ %TAB%]~

// Build a temporary dialogue source from the existing menu. Convert every
// ApplySpellRES("ID<range>_<color>",LastTalkedToBy) call into ChangeColor().
// This preserves all 115 gradients while avoiding persistent opcode-7 effects,
// which can desynchronise the native Appearance color controls.
COPY ~IWDEE-Tweaks-and-Fixes/dialogs/iwtfdye.d~
     ~IWDEE-Tweaks-and-Fixes/dialogs/iwtfdye_change_color.d~
  REPLACE_TEXTUALLY
    ~ApplySpellRES("ID\([03456]\)_\([0-9][0-9]*\)",LastTalkedToBy)~
    ~ActionOverride(LastTalkedToBy,ChangeColor(\1,\2))~

// Compile the converted dialogue, then retain the existing ITEMDIAL entry-state
// fix and the clearer palette-family labels already used on develop.
COMPILE ~IWDEE-Tweaks-and-Fixes/dialogs/iwtfdye_change_color.d~
COMPILE ~IWDEE-Tweaks-and-Fixes/dialogs/iwtfdye_start_fix.d~
COMPILE ~IWDEE-Tweaks-and-Fixes/dialogs/iwtfdye_family_labels.d~

// Place one identified copy in Pomab's Easthaven store. ADD_STORE_ITEM_EX
// avoids script-based delivery and safely skips a duplicate entry on reinstall.
COPY_EXISTING ~EHPOMAB.STO~ ~override~
  LPF ADD_STORE_ITEM_EX
    INT_VAR
      charge1   = 1
      stack     = 1
      unlimited = 0
    STR_VAR
      item_name = ~IWTFDYE~
      position  = ~FIRST~
      flags     = ~identified~
  END
BUT_ONLY
