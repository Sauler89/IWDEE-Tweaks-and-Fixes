// Restore the Enhanced Edition store-stealing controls in IWDEE while
// preserving Infinity UI++'s existing store layout and native stealing logic.
//
// The UI-side IsStealEnabled() gate is bypassed only for IWDEE. Single-item
// stealing still uses IsStealItemButtonClickable(), and multi-item stealing
// processes the selected merchandise one item at a time through the native
// OnStealItemButtonClick() path. Retail STO resources are marked stealable,
// but their existing stealing difficulty values are preserved.

COPY_EXISTING ~UI.MENU~ ~override~
  COUNT_REGEXP_INSTANCES
    ~enabled "(not storeScreen:IsContainer()) and storeScreen:IsStealEnabled()"~
    iwtf_steal_enabled_calls
  COUNT_REGEXP_INSTANCES
    ~clickable lua "storeScreen:IsStealItemButtonClickable() and (not storeScreen:IsContainer()) and storeScreen:IsStealEnabled()"~
    iwtf_steal_clickable_calls
  COUNT_REGEXP_INSTANCES
    ~storeScreen:OnStealItemButtonClick()~
    iwtf_steal_action_calls
  COUNT_REGEXP_INSTANCES
    ~function getStoreSlotHighlight(highlight)~
    iwtf_steal_helper_anchor_calls

  PATCH_IF ((iwtf_steal_enabled_calls != 1) ||
            (iwtf_steal_clickable_calls != 1) ||
            (iwtf_steal_action_calls != 1) ||
            (iwtf_steal_helper_anchor_calls != 1)) BEGIN
    PATCH_FAIL ~Could not safely identify Infinity UI++'s store-stealing controls in UI.MENU. Installation was stopped to avoid a partial UI patch.~
  END

  // Replace the original button action before inserting our helper, so the
  // native OnStealItemButtonClick() call inside the helper remains untouched.
  REPLACE_TEXTUALLY
    ~storeScreen:OnStealItemButtonClick()~
    ~iwtfStealSelectedItems()~

  REPLACE_TEXTUALLY
    ~enabled "(not storeScreen:IsContainer()) and storeScreen:IsStealEnabled()"~
    ~enabled "(not storeScreen:IsContainer()) and (storeScreen:IsStealEnabled() or rgGameEngine == 3)"~

  REPLACE_TEXTUALLY
    ~clickable lua "storeScreen:IsStealItemButtonClickable() and (not storeScreen:IsContainer()) and storeScreen:IsStealEnabled()"~
    ~clickable lua "iwtfCanStealSelectedItems()"~

  // Adapted from lefreut's Steal Multiple Items concept: selected entries are
  // collected, deselected, then stolen sequentially so the engine only ever
  // receives one selected store item per native stealing attempt.
  //
  // Infinity UI++'s character-screen currentID is not a reliable identifier
  // for the actor currently using a store. Instead, cache the engine's own
  // single-item steal eligibility as soon as exactly one unit is selected.
  // That preserves the native thief/kit check and can then safely keep the
  // button enabled when the user expands the selection to multiple items.
  REPLACE_TEXTUALLY
    ~function getStoreSlotHighlight(highlight)~
    ~iwtfStealNativeEligible = nil

function iwtfCanStealSelectedItems()
    if storeScreen:IsContainer() or storeScreen:IsSpriteOrderable() == false then
        iwtfStealNativeEligible = nil
        return false
    end

    local selectedRows = 0
    local selectedUnits = 0

    for _, v in pairs(store.storeItems) do
        if v.highlight == 1 then
            selectedRows = selectedRows + 1
            local amount = v.amountSelected or 1
            if amount < 1 then
                amount = 1
            end
            selectedUnits = selectedUnits + amount
        end
    end

    if selectedRows == 0 then
        iwtfStealNativeEligible = nil
        return false
    end

    -- With exactly one selected unit, defer completely to the engine and cache
    -- the result. This is where the native Thief/kit eligibility check occurs.
    if selectedUnits == 1 then
        iwtfStealNativeEligible = storeScreen:IsStealItemButtonClickable()
        return iwtfStealNativeEligible
    end

    -- The engine intentionally disables its own button test for multiple
    -- selections. Reuse the eligibility established by the preceding one-item
    -- state. Inventory capacity is based on selected store rows/stacks, not on
    -- the number of units inside a stack (for example, 64 arrows still occupy
    -- one store row here).
    return iwtfStealNativeEligible == true and selectedRows + #store.groupItems <= 16
end

function iwtfStealSelectedItems()
    local toSteal = {}

    for k, v in pairs(store.storeItems) do
        if v.highlight == 1 then
            local amount = v.amountSelected or 1
            table.insert(toSteal, v.item.name)
            for i = 2, amount do
                table.insert(toSteal, v.item.name)
            end
            storeScreen:SelectStoreItem(k - 1, false)
        end
    end

    for _, name in ipairs(toSteal) do
        local steal = 0

        for k, v in pairs(store.storeItems) do
            -- A previous native attempt left an item selected: stop rather than
            -- feed the engine an unsafe multiple-selection state.
            if v.highlight == 1 then
                steal = 0
                break
            end
            if v.item.name == name then
                steal = k
            end
        end

        if steal == 0 then
            break
        end

        storeScreen:SelectStoreItem(steal - 1, true)

        -- Recheck the engine's normal one-item rules for every attempt. This
        -- preserves class/kit eligibility and any other native restrictions.
        if storeScreen:IsStealItemButtonClickable() then
            storeScreen:OnStealItemButtonClick()
        else
            storeScreen:SelectStoreItem(steal - 1, false)
            break
        end
    end
end

function getStoreSlotHighlight(highlight)~

  PATCH_PRINT ~Infinity UI++ store stealing enabled for IWDEE, including sequential multiple-item stealing.~
BUT_ONLY

// Enable the store-level stealing flag only for real retail stores that have
// merchandise for sale. Taverns, inns, temples and container/bag STO files
// are deliberately left unchanged. The field layout used here is shared by
// the V1.0/V9.0 store resources relevant to IWDEE.
COPY_EXISTING_REGEXP GLOB ~.*\.sto~ ~override~
  PATCH_IF (SOURCE_SIZE > 0x3b) BEGIN
    READ_ASCII 0x00 iwtf_store_signature (4)
    READ_LONG  0x08 iwtf_store_type
    READ_LONG  0x10 iwtf_store_flags
    READ_LONG  0x38 iwtf_store_sale_count

    PATCH_IF ((~%iwtf_store_signature%~ STRING_EQUAL_CASE ~STOR~) &&
              (iwtf_store_type = 0) &&
              (iwtf_store_sale_count > 0)) BEGIN
      WRITE_LONG 0x10 (iwtf_store_flags BOR 0x00000008)
    END
  END
BUT_ONLY
