/*************************************************************************/
// IWDEE Tweaks and Fixes v0.4-dev
//
// Component 0: Enable BG2-style HLAs in IWDEE
// Component 1: Expanded Triple-Class HLA Tables
// Component 2: Thief Skill Points in Multiples of Five
// Component 3: Remove Summoning Cap for Celestials
// Component 4: Make Enhanced Bard Song Switchable
// Component 5: Bardic Wonders Extend Revised Bard Song Mechanics to IWDEE Classic Songs
// Component 6: Rework Giant Insect as IWD2-style Giant Vermin (IWDEE-balanced)
// Component 7: Rework Giant Insect as IWD2-style Giant Vermin (IWD2-faithful)
// Component 9: Enable Store Stealing
// Component 10: Chromatic Dye Kit
//
// Component-level requirements remain in this TP2. Runtime action code is
// split into component .tpa files and loaded with INCLUDE.
/*************************************************************************/

BACKUP ~IWDEE-Tweaks-and-Fixes/backup~
AUTHOR ~Sauler~
VERSION ~v0.4-dev~

LANGUAGE ~English~
         ~english~
         ~IWDEE-Tweaks-and-Fixes/languages/english/setup.tra~

BEGIN @15 DESIGNATED 0
SUBCOMPONENT @14
LABEL ~iwtf_hla_standard~
REQUIRE_PREDICATE (GAME_IS ~iwdee~) @1
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~infinity_ui.tp2~ ~0~) @2
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~UI.MENU~ @3
REQUIRE_PREDICATE FILE_EXISTS ~IWDEE-Tweaks-and-Fixes/2da/LUNUMAB-IWDEE.2DA~ @4
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~SW1H01.ITM~ @5
REQUIRE_PREDICATE !(MOD_IS_INSTALLED ~skills-and-abilities/skills-and-abilities.tp2~ ~730~) @8
INCLUDE ~IWDEE-Tweaks-and-Fixes/components/component0.tpa~
INCLUDE ~IWDEE-Tweaks-and-Fixes/components/component0_bw_hla_fix.tpa~

BEGIN @16 DESIGNATED 8
SUBCOMPONENT @14
LABEL ~iwtf_hla_rr_thief~
REQUIRE_PREDICATE (GAME_IS ~iwdee~) @1
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~infinity_ui.tp2~ ~0~) @2
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~UI.MENU~ @3
REQUIRE_PREDICATE FILE_EXISTS ~IWDEE-Tweaks-and-Fixes/2da/LUNUMAB-IWDEE.2DA~ @4
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~SW1H01.ITM~ @5
REQUIRE_PREDICATE !(MOD_IS_INSTALLED ~skills-and-abilities/skills-and-abilities.tp2~ ~730~) @8
REQUIRE_PREDICATE ((!(FILE_EXISTS_IN_GAME ~RR#THL01.SPL~)) OR
                   (MOD_IS_INSTALLED ~IWDEE-Tweaks-and-Fixes/IWDEE-Tweaks-and-Fixes.tp2~ ~8~) OR
                   (FILE_EXISTS_IN_GAME ~IWRRHL01.ITM~)) @17
REQUIRE_PREDICATE ((FILE_EXISTS_IN_GAME ~KITLIST.2DA~) AND (FILE_EXISTS_IN_GAME ~LUABBR.2DA~)) @18
REQUIRE_PREDICATE ((FILE_EXISTS_IN_GAME ~STATE.IDS~) AND
                   (FILE_EXISTS_IN_GAME ~SPCL910.SPL~) AND
                   (FILE_EXISTS_IN_GAME ~SPCL910B.SPL~) AND
                   (FILE_EXISTS_IN_GAME ~SPCL911.SPL~) AND
                   (FILE_EXISTS_IN_GAME ~SPCL912.SPL~) AND
                   (FILE_EXISTS_IN_GAME ~SPCL913.SPL~) AND
                   (FILE_EXISTS_IN_GAME ~SPCL914.SPL~) AND
                   (FILE_EXISTS_IN_GAME ~SPCL918.SPL~) AND
                   (FILE_EXISTS_IN_GAME ~SPCL919.SPL~)) @19
INCLUDE ~IWDEE-Tweaks-and-Fixes/components/component0.tpa~
INCLUDE ~IWDEE-Tweaks-and-Fixes/components/component0_bw_hla_fix.tpa~
INCLUDE ~IWDEE-Tweaks-and-Fixes/components/component0_rr_thief_hla.tpa~
INCLUDE ~IWDEE-Tweaks-and-Fixes/components/component0_rr_shadowdancer_hla.tpa~
INCLUDE ~IWDEE-Tweaks-and-Fixes/components/component0_rr_bard_shared_hla.tpa~

BEGIN @20 DESIGNATED 1
REQUIRE_PREDICATE (GAME_IS ~iwdee~) @1
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~MOHLA01.ITM~ @21
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~LUABBR.2DA~ @22
REQUIRE_PREDICATE ((FILE_EXISTS_IN_GAME ~LUFMC.2DA~) OR (FILE_EXISTS_IN_GAME ~LUFC0.2DA~)) @26
REQUIRE_PREDICATE ((FILE_EXISTS_IN_GAME ~LUFMT.2DA~) OR (FILE_EXISTS_IN_GAME ~LUFT0.2DA~)) @27
INCLUDE ~IWDEE-Tweaks-and-Fixes/components/component1.tpa~

BEGIN @30 DESIGNATED 2
REQUIRE_PREDICATE (GAME_IS ~iwdee~) @1
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~infinity_ui.tp2~ ~0~) @31
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~UI.MENU~ @32
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~THIEFSKL.2DA~ @33
REQUIRE_PREDICATE !(MOD_IS_INSTALLED ~stratagems/setup-stratagems.tp2~ ~4115~) @36
INCLUDE ~IWDEE-Tweaks-and-Fixes/components/component2.tpa~

BEGIN @40 DESIGNATED 3
REQUIRE_PREDICATE (GAME_IS ~iwdee~) @1
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~SUMMLIMT.2DA~ @41
REQUIRE_PREDICATE !(MOD_IS_INSTALLED ~cdtweaks/setup-cdtweaks.tp2~ ~2340~) @42
INCLUDE ~IWDEE-Tweaks-and-Fixes/components/component3.tpa~

BEGIN @50 DESIGNATED 4
REQUIRE_PREDICATE (GAME_IS ~iwdee~) @1
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~MOHLA01.ITM~ @21
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~SPCL920.SPL~ @51
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~#BARD1.SPL~ @52
REQUIRE_PREDICATE !(FILE_EXISTS_IN_GAME ~#BARD7.SPL~) @56
INCLUDE ~IWDEE-Tweaks-and-Fixes/components/component4.tpa~

BEGIN @70 DESIGNATED 5
REQUIRE_PREDICATE (GAME_IS ~iwdee~) @1
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~C0BARDX.SPL~ @71
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~C0BARDSX.SPL~ @71
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~C0SINGI2.SPL~ @71
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~#BARD1.SPL~ @72
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~#BARD2.SPL~ @72
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~#BARD3.SPL~ @72
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~#BARD4.SPL~ @72
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~#BARD5.SPL~ @72
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~#BARD6.SPL~ @72
