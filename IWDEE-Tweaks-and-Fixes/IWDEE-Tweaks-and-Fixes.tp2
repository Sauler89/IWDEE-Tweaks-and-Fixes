BEGIN @92 DESIGNATED 6
SUBCOMPONENT @80
REQUIRE_PREDICATE (GAME_IS ~iwdee~) @1
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~SPPR418.SPL~ @81
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~BEETLEG.CRE~ @82
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~GISBOMB.CRE~ @88
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~GISBORB.CRE~ @89
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~BEETRHIN.CRE~ @90
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~GNSUMMM.BCS~ @83
REQUIRE_PREDICATE ((FILE_EXISTS ~IWDEE-Tweaks-and-Fixes/2da/IWGVT07.2DA~) AND
                   (FILE_EXISTS ~IWDEE-Tweaks-and-Fixes/2da/IWGVT09.2DA~) AND
                   (FILE_EXISTS ~IWDEE-Tweaks-and-Fixes/2da/IWGVT11.2DA~) AND
                   (FILE_EXISTS ~IWDEE-Tweaks-and-Fixes/2da/IWGVT13.2DA~) AND
                   (FILE_EXISTS ~IWDEE-Tweaks-and-Fixes/2da/IWGVT15.2DA~)) @84
OUTER_SET iwtf_gv_balanced_mode = 1
INCLUDE ~IWDEE-Tweaks-and-Fixes/components/component6.tpa~

BEGIN @93 DESIGNATED 7
SUBCOMPONENT @80
REQUIRE_PREDICATE (GAME_IS ~iwdee~) @1
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~SPPR418.SPL~ @81
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~BEETLEG.CRE~ @82
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~GISBOMB.CRE~ @88
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~GISBORB.CRE~ @89
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~BEETRHIN.CRE~ @90
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~GNSUMMM.BCS~ @83
REQUIRE_PREDICATE ((FILE_EXISTS ~IWDEE-Tweaks-and-Fixes/2da/IWGVT07.2DA~) AND
                   (FILE_EXISTS ~IWDEE-Tweaks-and-Fixes/2da/IWGVT09.2DA~) AND
                   (FILE_EXISTS ~IWDEE-Tweaks-and-Fixes/2da/IWGVT11.2DA~) AND
                   (FILE_EXISTS ~IWDEE-Tweaks-and-Fixes/2da/IWGVT13.2DA~) AND
                   (FILE_EXISTS ~IWDEE-Tweaks-and-Fixes/2da/IWGVT15.2DA~)) @84
OUTER_SET iwtf_gv_balanced_mode = 0
INCLUDE ~IWDEE-Tweaks-and-Fixes/components/component6.tpa~

BEGIN ~Enable Store Stealing~ DESIGNATED 9
LABEL ~iwtf_store_stealing~
REQUIRE_PREDICATE (GAME_IS ~iwdee~) ~This component is only for Icewind Dale: Enhanced Edition.~
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~infinity_ui.tp2~ ~0~) ~Infinity UI++ must be installed first.~
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~UI.MENU~ ~UI.MENU is missing; Infinity UI++ must be installed correctly first.~
INCLUDE ~IWDEE-Tweaks-and-Fixes/components/component9.tpa~

BEGIN ~Chromatic Dye Kit~ DESIGNATED 10
LABEL ~iwtf_chromatic_dye_kit~
REQUIRE_PREDICATE (GAME_IS ~iwdee~) ~This component is only for Icewind Dale: Enhanced Edition.~
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~ITEMDIAL.2DA~ ~ITEMDIAL.2DA is missing; the reusable item dialog cannot be installed.~
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~SW1H01.ITM~ ~SW1H01.ITM is missing; the Chromatic Dye Kit cannot be built.~
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~BALDUR.BCS~ ~BALDUR.BCS is missing; the Chromatic Dye Kit cannot be delivered automatically.~
INCLUDE ~IWDEE-Tweaks-and-Fixes/components/component10.tpa~
