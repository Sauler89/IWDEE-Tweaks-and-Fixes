// Rogue Rebalancing Scribe Scrolls dialogue, adapted for IWDEE Bards.
BEGIN ~RR#SCRL~

IF ~True()~ THEN BEGIN RR#SCRL00
SAY @8222
IF ~PartyGoldGT(49)~ THEN REPLY @8230 GOTO RR#SCRL01
IF ~PartyGoldGT(99)~ THEN REPLY @8231 GOTO RR#SCRL02
IF ~PartyGoldGT(149)~ THEN REPLY @8232 GOTO RR#SCRL03
IF ~PartyGoldGT(249)~ THEN REPLY @8233 GOTO RR#SCRL04
IF ~PartyGoldGT(499)~ THEN REPLY @8234 GOTO RR#SCRL05
IF ~PartyGoldGT(999)~ THEN REPLY @8235 GOTO RR#SCRL06
IF ~~ THEN REPLY @8250 EXIT
END
